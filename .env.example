# OAuth Credentials
# In development, you can use the "Developer Login" button without setting these.
# For production, configure all providers you want to support.

# GitHub OAuth App
# Register at: https://github.com/settings/applications/new
# DEV callback:  http://localhost:3000/auth/github/callback
# PROD callback: https://tour.skipmaple.com/auth/github/callback
# NOTE: GitHub only allows one callback URL per app — create two separate apps (dev + prod).
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth 2.0 Client
# Register at: https://console.cloud.google.com → APIs & Services → Credentials
# Add BOTH redirect URIs to the same credential:
#   http://localhost:3000/auth/google_oauth2/callback
#   https://tour.skipmaple.com/auth/google_oauth2/callback
# Keep OAuth consent screen in "Testing" mode for personal use (no Google review needed).
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Feishu (飞书) Self-Built App (自建应用)
# Register at: https://open.feishu.cn/app → 创建自建应用
# Add BOTH redirect URIs under 安全设置 → 重定向 URL:
#   http://localhost:3000/auth/feishu/callback
#   https://tour.skipmaple.com/auth/feishu/callback
# Required scopes: contact:user.base, contact:user.email:readonly
# Must publish a version before OAuth works.
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# LLM (RubyLLM)
# Default: LM Studio local server. Change for cloud providers.
OPENAI_API_KEY=lm-studio
OPENAI_API_BASE=http://localhost:1234/v1
LLM_MODEL=qwen2.5-7b-instruct

# Geocoding (at least one required for map coordinates)
AMAP_API_KEY=your_amap_key
# GOOGLE_MAPS_API_KEY=your_google_maps_key
